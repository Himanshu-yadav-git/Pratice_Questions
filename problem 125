# Problem Statement: Print an Alternating Binary Triangle Pattern
# Write a Java program to print a right-angled triangle pattern consisting of alternating 1s and 0s.

# code 

public class Main {
    public static void main(String[] args){
        boolean e = true;

        for (int i = 1; i < 6; i++){
            for (int j = 1; j <= i;j++){
                if (e){
                    System.out.print("1");
                    e = false;
                }
                else {
                    System.out.print("0");
                    e = true;
                }
            }
            if (i % 2 == 0){
                e = false;
            }
            System.out.println();
        }
    }
}
