# Practice Problem: Write a program to print the following pattern using nested loops:

* 
* * 
* * * 
* * * * 
* * * * * 
* * * * 
* * * 
* * 
*

# code 

for i in range(1,5):
    for j in range(0,i):
        print("*", end=" ")
        
    print()
for i in range(3,0,-1):
    for j in range(0,i):
        print("*", end=" ")
    print()
