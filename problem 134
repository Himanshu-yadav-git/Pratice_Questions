# Practice Problem: Write a program to remove all duplicate values from a list using a loop, maintaining the original order of elements.

# code 

list = [1, 2, 2, 3, 4, 4, 4, 5]
new_list = []
for i in list:
    if i in new_list:
        continue
    else:
        new_list.append(i)

print(new_list)
