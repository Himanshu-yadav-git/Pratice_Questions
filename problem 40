# Write a Python program to sort an array of integers in ascending order using the Insertion Sort algorithm, without using built-in sorting functions.

#code 

nums = [9, 5, 1, 4, 3, 8, 2]
n = len(nums)

for i in range(1, n):
    key = nums[i]
    j = i - 1

    while j >= 0 and nums[j] > key:
        nums[j+1] = nums[j]
        j -= 1

    nums[j+1] = key

print(nums)
