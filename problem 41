# Merge Sort is a Divide and Conquer sorting algorithm. It divides an array into smaller parts, sorts those parts, and then merges them back together in ascending #order.

#code 

def merge_sort(arr):
    if len(arr) <= 1:
        return arr

    mid = len(arr) // 2

    left = merge_sort(arr[:mid])
    right = merge_sort(arr[mid:])

    return merge(left, right)


def merge(left, right):
    result = []

    i = 0
    j = 0

    while i < len(left) and j < len(right):
        if left[i] < right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    result.extend(left[i:])
    result.extend(right[j:])

    return result


nums = [8, 3, 5, 4, 7, 6, 1, 2]

print(merge_sort(nums))
