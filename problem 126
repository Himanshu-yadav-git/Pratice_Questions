# Problem Statement: Print a Symmetrical Butterfly Pattern Using Stars
# Write a Java program to print a symmetrical butterfly-shaped pattern using * characters.

# code 

public class Main {
    public static void main(String[] args) {

        for (int i = 1; i <= 4; i++) {
            for (int j = 0; j < i; j++)
                System.out.print("*");

            for (int j = 0; j < 8 - 2*i; j++)
                System.out.print(" ");

            for (int j = 0; j < i; j++)
                System.out.print("*");

            System.out.println();
        }

        for (int i = 4; i >= 1; i--) {
            for (int j = 0; j < i; j++)
                System.out.print("*");

            for (int j = 0; j < 8 - 2*i; j++)
                System.out.print(" ");

            for (int j = 0; j < i; j++)
                System.out.print("*");

            System.out.println();
        }
    }
}
