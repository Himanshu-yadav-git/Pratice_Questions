# Centered Number Pyramid
# Write a Java program to print a centered number pattern consisting of 5 rows.

# code 

public class Main {
    public static void main(String[] args){
        int n = 5;

        for (int i =1; i < n+1;i++){
            for (int j = 0; j < 5-i;j++){
                System.out.print(" ");
            }
            for (int j = 5-i; j < 5-i+i; j++){
                System.out.print(i+" ");
            }
            for (int j = 0; j < 5-i;j++){
                System.out.print(" ");
            }
            System.out.println();
        }
    }
}
