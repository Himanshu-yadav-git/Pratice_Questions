# Practice Problem: Write a Java program to print all numbers from 1 to N that are divisible by 3 or 5, skipping the rest

# code 

import java.util.Scanner;

public class Main {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter your number: ");
        int n = sc.nextInt();

        for (int i = 1; i < n+1; i++){
            if (i % 3 == 0){
                System.out.println(i);
            } else if (i % 5 == 0) {
                System.out.println(i);
            }
        }
    }
}
