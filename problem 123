# Problem Statement:

# Write a Java program to print a right-aligned inverted triangular pattern using stars (*).

# code 

public class Main {
    public static void main(String[] args){
        int a = 5;

        for (int i = 5; i > 0; i--){
            for (int j = 0; j < i; j++){
                System.out.print(" ");
            }
            for (int j = i; j < 6; j++){
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
