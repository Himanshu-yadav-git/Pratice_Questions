# Write a Python function that takes an array and reverses its elements in place using recursion, without using loops or Python's built-in reverse() method.

#code 

def fxn(arr, left, right):
    if left >= right:
        return

    arr[left], arr[right] = arr[right], arr[left]

    fxn(arr, left+1, right-1)


arr = [1, 2, 3, 4, 5]

fxn(arr, 0, len(arr)-1)

print(arr)
