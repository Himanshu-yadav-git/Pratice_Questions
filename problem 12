# Practice Problem: Write a function to return True if the first and last number of a given list is the same. If the numbers are different, return False

#code 

def check_list(nums):
    if nums[0] == nums[-1]:
        return True
    else:
        return False


print(check_list([10, 20, 30, 10]))
print(check_list([1, 2, 3, 4]))
