# Problem Statement: Print a Symmetrical Palindromic Number Pyramid
# Write a Java program to print a centered pyramid pattern of numbers consisting of 5 rows.

# code 

public class Main {
    public static void main(String[] args){
        int n = 5;

        for (int i = 1; i < n+1; i++){
            for (int j = 0; j < n-i; j++){
                System.out.print("  ");
            }

            for (int j = i; j > 0; j--){
                System.out.print(j+" ");
            }

            for (int j = 2; j < i+1; j++){
                System.out.print(j+" ");
            }
            System.out.println();
        }
    }
}
