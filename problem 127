# Problem Statement: Print a Right-Aligned Star Pattern with Trailing Spaces
# Write a Java progrom to print a pattern consisting of 5 rows, where each row contains exactly 5 stars (*).

# code 

public class Main {
    public static void main(String[] args){
        int n = 5;

        for (int i = 0; i < n;i++){
            for(int j = 0; j < (n*2)-1-i; j++){
                System.out.print(" ");
            }
            for (int j = (n*2)-1; j < (n*2)-1+5;j++){
                System.out.print("*");
            }
            for (int j = (n*2)-1+5; j < (n*2)-1+5+i; j++){
                System.out.print(" ");
            }
            System.out.println();
        }
    }
}
