# Practice Problem: Given a list of integers, move all even numbers to the beginning of the list and all odd numbers to the end.

# code 

nums = [1, 2, 3, 4, 5, 6]
new_nums = []
for i in nums:
    if i % 2 == 0:
        new_nums.append(i)
for i in nums:
    if i % 2 != 0:
        new_nums.append(i)

print(new_nums)
