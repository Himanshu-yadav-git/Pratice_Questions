# Practice Problem: Write a program that sorts an integer array in ascending order using the Bubble Sort algorithm and prints the sorted result.

# code 

public class Main {
    public static void main(String[] args){
        int [] arr = {5,4,3,2,1};
        int n = arr.length;
        int j = 0;
        int temp;

        while(j < n-1){
            int i = 0;

            while (i <= n-2-j) {
                if (arr[i] > arr[i+1]){
                    temp = arr[i];
                    arr[i] = arr[i+1];
                    arr[i+1] = temp;
                    i++;
                }
                else{
                    i++;
                }
            }
            j++;

        }

        for (int k: arr){
            System.out.print(k+" ");
        }
    }
}
